<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/navy">
    <FrameLayout android:id="@+id/cameraPane" android:layout_width="0dp"
        android:layout_height="@dimen/camera_viewport_height" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.camera.view.PreviewView android:id="@+id/previewView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" app:implementationMode="compatible" app:scaleType="fillCenter" />
        <View android:id="@+id/scanFrame" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_margin="20dp" android:background="@drawable/bg_scan_frame"
            android:contentDescription="@string/scan_area_description" />
        <kr.co.addresslens.FrozenSelectionView android:id="@+id/frozenSelection"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
            android:contentDescription="@string/frozen_selection_description" />
        <com.google.android.material.button.MaterialButton android:id="@+id/freezeButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="4dp" android:minHeight="48dp"
            android:text="@string/freeze_frame" android:visibility="gone" />
        <TextView android:id="@+id/zoomText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="8dp"
            android:padding="6dp" android:background="#99000000"
            android:textColor="@android:color/white" android:textSize="12sp"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/informationPanel"
        android:layout_width="0dp" android:layout_height="0dp" android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/cameraPane" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/infoToolbar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="@dimen/main_content_max_width">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/address_search_title" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/apiKeyButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/settings" android:textSize="14sp" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/resultCard"
            android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="false"
            android:clipToPadding="false" android:overScrollMode="ifContentScrolls"
            app:layout_constraintTop_toBottomOf="@id/infoToolbar" app:layout_constraintBottom_toTopOf="@id/actionBar"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="@dimen/main_content_max_width">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                <kr.co.addresslens.ActionRow android:id="@+id/quickActions" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/regionButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="start|center_vertical" android:minWidth="0dp" android:minHeight="48dp"
                android:maxLines="2" android:ellipsize="end" android:textColor="@color/ink" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/flashButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/flash" android:textSize="14sp" />
                </kr.co.addresslens.ActionRow>
        <kr.co.addresslens.ActionRow android:id="@+id/frozenActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone" android:paddingStart="8dp" android:paddingEnd="8dp"
              >
            <com.google.android.material.button.MaterialButton android:id="@+id/recognizeSelectionButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/recognize_selection" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resumeCameraButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/resume_camera" />
        </kr.co.addresslens.ActionRow>
                <com.google.android.material.button.MaterialButton android:id="@+id/pauseScanButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:visibility="gone" android:text="@string/pause_scan" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/recognized_label" android:labelFor="@id/addressInput"
                        android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/copyInputButton"
                        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:enabled="false"
                        android:contentDescription="@string/copy_input_address" app:srcCompat="@drawable/ic_copy"
                        app:tint="@color/copy_button_tint" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/addressInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:hintEnabled="false" app:endIconMode="clear_text">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/addressInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:maxLines="2" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:imeOptions="actionSearch" android:inputType="textPostalAddress|textMultiLine"
                        android:hint="@string/address_input_hint"
                        android:textColor="@color/ink" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/convertedAddressLabel" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/converted_label"
                    android:textColor="@color/muted" android:textSize="14sp" android:textStyle="bold" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/copyResultButton"
                        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:enabled="false"
                        android:contentDescription="@string/copy_result_address" app:srcCompat="@drawable/ic_copy"
                        app:tint="@color/copy_button_tint" />
                </LinearLayout>
                <TextView android:id="@+id/roadAddressText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/waiting_road"
                    android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/statusText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/detailText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/muted" android:textSize="13sp" android:visibility="gone" android:layout_marginTop="4dp" />
                <LinearLayout android:id="@+id/candidatePanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/candidate_label" android:textColor="@color/muted" android:textSize="12sp" />
                    <TextView android:id="@+id/candidateEmptyText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical"
                        android:text="@string/waiting_candidates" android:textColor="@color/muted" android:textSize="13sp" />
                    <LinearLayout android:id="@+id/candidateContainer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/mapButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:enabled="false"
                    android:contentDescription="@string/map_button_description" android:text="@string/open_in_map" app:icon="@drawable/ic_map" />
                <TextView android:id="@+id/developerText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/muted" android:textSize="11sp" android:visibility="gone" android:paddingTop="8dp" android:paddingBottom="8dp" />
                <ImageView android:id="@+id/developerCrop" android:layout_width="match_parent" android:layout_height="100dp"
                    android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="@string/processed_crop" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <kr.co.addresslens.ActionRow android:id="@+id/actionBar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="4dp" android:paddingBottom="6dp" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="@dimen/main_content_max_width">
            <com.google.android.material.button.MaterialButton android:id="@+id/convertButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                 android:minHeight="52dp" android:text="@string/convert"
                android:textColor="@color/white" app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/scanAgainButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp" android:text="@string/scan_again" app:cornerRadius="12dp" />
        </kr.co.addresslens.ActionRow>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout android:id="@+id/permissionPanel" android:layout_width="0dp" android:layout_height="0dp"
        android:background="@color/navy" android:gravity="center" android:orientation="vertical"
        android:padding="24dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/cameraPane" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="@string/camera_permission_needed" android:textColor="@color/white" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/permissionButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grant_permission" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

